@echo off
chcp 65001 >nul
title MCP Server 1C Launcher

echo ========================================
echo  Запуск MCP сервера для 1C Agent
echo ========================================
echo.

REM Укажите здесь путь к вашей папке с проектом, если батник лежит не в ней
REM Если батник лежит в папке проекта, путь не нужен

echo Активация виртуального окружения...
call .\.venv\Scripts\activate.bat

if %errorlevel% neq 0 (
    echo ОШИБКА: Не удалось активировать venv.
    echo Проверьте, существует ли папка 'venv' и правильно ли указан путь.
    pause
    exit /b 1
)

echo Виртуальное окружение активировано.
echo Запуск mcp_server.py...
echo.

REM Запускаем ваш скрипт. Если имя другое, измените 'server.py'
python mcp_server.py

echo.
echo ========================================
echo  Сервер остановлен.
echo ========================================
pause
