// =========================================================
// Раннер 1С-агента для ОБЫЧНОГО ПРИЛОЖЕНИЯ.
//
// Зачем отдельный раннер. Основной (ВнешняяОбработка.epf) построен на
// УПРАВЛЯЕМОЙ форме и в конфигурациях с обычным приложением не открывается
// вообще — проверено на УПП 1.3.254 (режим совместимости 8.2.16, режим
// совместимости интерфейса 8.2). Там же недоступны расширения конфигурации,
// так что обходного пути через .cfe нет.
//
// Устройство: ОБЫЧНАЯ ФОРМА + ТИК. Форма (её разметку текстом не
// сгенерировать, поэтому она сделана в конфигураторе руками) раз в секунду
// вызывает РаннерТик() через ПодключитьОбработчикОжидания. Бесконечного
// цикла здесь НЕТ намеренно: пока он крутился в теле модуля, окно 1С
// помечалось "не отвечает" и сеанс убивался только через диспетчер задач.
// Адрес агента приходит из поля формы ПутьОбмена через УстановитьАдрес().
//
// Что проверено живьём в режиме 8.2.16 и потому используется без опаски:
// ПараметрЗапуска (/C), ЗащищенноеСоединениеOpenSSL, HTTPСоединение с
// таймаутом, ЧтениеJSON/ЗаписьJSON, Base64Значение, запись ДвоичныхДанных в
// файл, ВнешниеОбработки.Создать(<путь>), Выполнить(), Запрос, живой HTTPS GET.
//
// Протокол с агентом — ТОТ ЖЕ, что у управляемого раннера (см.
// ВнешняяОбработка.Form.Форма.Form.Module.txt): GET /task?wait=N с заголовком
// X-Agent-Token, 204 = заданий нет, 200 = JSON {seq, mode, code|epf_b64},
// ответ POST /result с {seq, status, log}. Питон-сторону менять не требуется.
//
// Отличия от управляемого раннера, продиктованные обычным приложением:
//   * нет директив компиляции — контекст один (толстый клиент);
//   * нет ПоместитьВоВременноеХранилище-пути для .epf: задание сохраняется во
//     ВРЕМЕННЫЙ ФАЙЛ и поднимается через ВнешниеОбработки.Создать(<путь>).
//     ВнешниеОбработки.Подключить — метод управляемого приложения, здесь его
//     нет;
//   * нет режима "выполнить на клиенте": клиент и сервер тут не разделены,
//     весь код и так исполняется в толстом клиенте.
//
// Запуск:
//   1cv8.exe ENTERPRISE <строка базы> /Execute "РаннерОбычный.epf" /C<адрес>
// где <адрес> — https://хост[:порт]#токен (раннер ходит к агенту сам, наружу
// торчит только /task /result /ping /status).
// =========================================================

Перем Разбор;              // Структура: Схема, Хост, Порт, Токен
Перем ПутьЛога;
Перем ПутьСтопФлага;
Перем ПутьСтопФлагаПростой;
Перем БезопасныйРежимРаботы;
Перем ОжиданиеОпроса;      // секунды длинного опроса
Перем СпособПаузы;         // 0 — ещё не выбран, 1 — Приостановить, 2 — WScript.Shell, 3 — активное ожидание
Перем ОшибокПодряд;        // сколько опросов подряд не дошли до агента
Перем Работает;            // идёт ли опрос (кнопка/стоп-флаг)
Перем Проверено;           // связь проверена на первом тике

Процедура Лог(Знач Текст)
	Попытка
		Ф = Новый ТекстовыйДокумент;
		Файл_ = Новый Файл(ПутьЛога);
		// Перечитывание всего файла на каждую строку — это O(n^2); при сбое,
		// когда сообщения сыплются пачкой, лог разрастался до сотен тысяч строк
		// и тормозил сам цикл. Поэтому выше порога начинаем файл заново.
		Если Файл_.Существует() И Файл_.Размер() < 200000 Тогда
			Ф.Прочитать(ПутьЛога, КодировкаТекста.UTF8);
		КонецЕсли;
		Ф.ДобавитьСтроку(Строка(ТекущаяДата()) + ": " + Текст);
		Ф.Записать(ПутьЛога, КодировкаТекста.UTF8);
	Исключение
		// лог вспомогательный — из-за него цикл падать не должен
	КонецПопытки;
КонецПроцедуры

Функция РазобратьАдресАгента(Знач Адрес)
	Рез = Новый Структура("Схема, Хост, Порт, Токен", "http", "", 80, "");
	Текст = СокрЛП(Адрес);

	Поз = Найти(Текст, "#");
	Если Поз > 0 Тогда
		Рез.Токен = СокрЛП(Сред(Текст, Поз + 1));
		Текст = Лев(Текст, Поз - 1);
	КонецЕсли;

	Если Лев(НРег(Текст), 8) = "https://" Тогда
		Рез.Схема = "https";
		Рез.Порт = 443;
		Текст = Сред(Текст, 9);
	ИначеЕсли Лев(НРег(Текст), 7) = "http://" Тогда
		Текст = Сред(Текст, 8);
	КонецЕсли;

	Поз = Найти(Текст, "/");
	Если Поз > 0 Тогда
		Текст = Лев(Текст, Поз - 1);
	КонецЕсли;

	Поз = Найти(Текст, ":");
	Если Поз > 0 Тогда
		Рез.Хост = Лев(Текст, Поз - 1);
		Рез.Порт = Число(Сред(Текст, Поз + 1));
	Иначе
		Рез.Хост = Текст;
	КонецЕсли;

	Возврат Рез;
КонецФункции

Функция СоединениеСАгентом()
	Защита = Неопределено;
	Если Разбор.Схема = "https" Тогда
		Защита = Новый ЗащищенноеСоединениеOpenSSL;
	КонецЕсли;
	// Таймаут заведомо больше длинного опроса, иначе рвём собственный запрос
	// раньше, чем агент успеет ответить.
	Возврат Новый HTTPСоединение(Разбор.Хост, Разбор.Порт, , , , ОжиданиеОпроса + 15, Защита);
КонецФункции

// Пауза без нагрузки на процессор.
//
// ГРАБЛЯ, поймана живьём на стенде 8.2.16: глобального Приостановить() в этом
// режиме НЕТ, и обращение к нему — ошибка КОМПИЛЯЦИИ модуля, а не исключение.
// Обернуть его в Попытка недостаточно: модуль не компилируется целиком и
// обработка не запускается вовсе ("Процедура или функция с указанным именем
// не определена (Приостановить)"). Поэтому вызов идёт ТОЛЬКО через Выполнить()
// — тот компилируется в момент вызова, и отсутствие метода становится
// обычным перехватываемым исключением.
//
// Порядок способов (первый сработавший запоминается в СпособПаузы):
//   1 — Приостановить() через Выполнить(), если платформа его знает;
//   2 — WScript.Shell.Run("ping ...", 0, Истина): скрытое окно, синхронно,
//       процессор не греет. Окно именно СКРЫТОЕ (второй параметр 0) — иначе
//       на сервере каждые несколько секунд мигала бы консоль;
//   3 — активное ожидание. Дорого по CPU, поэтому только если не вышло ничего.
Процедура Подождать(Знач Секунды)
	Если СпособПаузы = 0 Или СпособПаузы = 1 Тогда
		Попытка
			Выполнить("Приостановить(" + Формат(Секунды * 1000, "ЧН=0; ЧГ=0") + ")");
			СпособПаузы = 1;
			Возврат;
		Исключение
			Если СпособПаузы = 1 Тогда
				СпособПаузы = 0;   // работал, а теперь нет — пробуем дальше
			КонецЕсли;
		КонецПопытки;
	КонецЕсли;

	Если СпособПаузы = 0 Или СпособПаузы = 2 Тогда
		Попытка
			Оболочка = Новый COMОбъект("WScript.Shell");
			Оболочка.Run("cmd /c ping -n " + Формат(Секунды + 1, "ЧН=0; ЧГ=0") + " 127.0.0.1 > nul", 0, Истина);
			СпособПаузы = 2;
			Возврат;
		Исключение
			Если СпособПаузы = 2 Тогда
				СпособПаузы = 0;
			КонецЕсли;
		КонецПопытки;
	КонецЕсли;

	СпособПаузы = 3;
	Край = ТекущаяДата() + Секунды;
	Пока ТекущаяДата() < Край Цикл
		ОбработкаПрерыванияПользователя();
	КонецЦикла;
КонецПроцедуры

// Тот же приём, что и в Подождать(): метод дёргается через Вычислить(), а не
// напрямую. ПолучитьСообщенияПользователю в обычном приложении может
// отсутствовать, и прямой вызов сделал бы весь модуль некомпилируемым —
// ровно так уже случилось с Приостановить().
Функция СобратьЛогСообщений(Знач ЛогВыполнения)
	Попытка
		Сообщения = Вычислить("ПолучитьСообщенияПользователю(Истина)");
		Для Каждого Сообщение Из Сообщения Цикл
			ЛогВыполнения = ЛогВыполнения + Символы.ПС + Сообщение.Текст;
		КонецЦикла;
	Исключение
		// Накопление сообщений недоступно — в логе останется только то, что
		// задание положило в ЛогВыполнения само. Ронять задание из-за этого
		// нельзя.
	КонецПопытки;
	Возврат ЛогВыполнения;
КонецФункции

Функция ВыполнитьТекст(Знач ТекстКода)
	ЛогВыполнения = "";
	ТекстОшибки = "";
	Попытка
		Если БезопасныйРежимРаботы Тогда
			Попытка
				// через Выполнить: метода может не быть в этом режиме
				// совместимости, а прямой вызов ломал бы компиляцию модуля
				Выполнить("УстановитьБезопасныйРежим(Истина)");
			Исключение
				Лог("Безопасный режим включить не удалось: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		// Выполнить() исполняет код В КОНТЕКСТЕ ЭТОЙ ЖЕ функции, поэтому задание
		// пишет в ЛогВыполнения напрямую — как и в управляемом раннере.
		Выполнить(ТекстКода);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Новый Структура("ЛогИИ, ОшибкаСистемы", СобратьЛогСообщений(ЛогВыполнения), ТекстОшибки);
КонецФункции

Функция ВыполнитьОбработку(Знач ДвоичныеДанныеEPF)
	ЛогВыполнения = "";
	ТекстОшибки = "";
	ВремФайл = КаталогВременныхФайлов() + "AgentCode_" + Строка(Новый УникальныйИдентификатор) + ".epf";
	Попытка
		ДвоичныеДанныеEPF.Записать(ВремФайл);
		// В обычном приложении нет ВнешниеОбработки.Подключить — обработка
		// поднимается прямо из файла. Второй параметр — безопасный режим.
		ОбработкаОбъект = ВнешниеОбработки.Создать(ВремФайл, БезопасныйРежимРаботы);
		ОбработкаОбъект.ВыполнитьЗадачу(ЛогВыполнения);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Попытка
		УдалитьФайлы(ВремФайл);
	Исключение
		// временный файл мог остаться занятым — переживём
	КонецПопытки;
	Возврат Новый Структура("ЛогИИ, ОшибкаСистемы", СобратьЛогСообщений(ЛогВыполнения), ТекстОшибки);
КонецФункции

// Истина -> агент принял результат.
Функция ОтправитьРезультат(Знач НомерЗадания, Знач Результат)
	Статус = "OK";
	Если Не ПустаяСтрока(Результат.ОшибкаСистемы) Тогда
		Статус = Результат.ОшибкаСистемы;
	ИначеЕсли Найти(Результат.ЛогИИ, "ГОТОВО") = 0 Тогда
		Статус = "START";
	КонецЕсли;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Новый Структура("seq, status, log", НомерЗадания, Статус, Результат.ЛогИИ));

	Отправка = Новый HTTPЗапрос("/result");
	Отправка.Заголовки.Вставить("X-Agent-Token", Разбор.Токен);
	Отправка.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	ТелоСтрокой = Запись.Закрыть();
	// БЕЗ BOM. Поймано живьём: УстановитьТелоИзСтроки(..., КодировкаТекста.UTF8)
	// без третьего параметра ставит в начало тела BOM, питон-сторона отвечала
	// 400 "не разобрал тело: Unexpected UTF-8 BOM", раннер считал задание
	// выполненным и брал его снова — получался бесконечный повтор одного
	// задания. Транспорт теперь читает тело как utf-8-sig, но и раннеру BOM
	// слать незачем.
	Отправка.УстановитьТелоИзСтроки(ТелоСтрокой, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	ОтветАгента = СоединениеСАгентом().ОтправитьДляОбработки(Отправка);
	// Агент отвечает {"accepted": true/false}. false означает, что задание он
	// уже снял (или пришёл чужой seq) — это надо видеть в логе, иначе молчаливый
	// провал выглядит как бесконечный повтор одного и того же задания.
	Если ОтветАгента.КодСостояния <> 200 Или Найти(ОтветАгента.ПолучитьТелоКакСтроку("UTF-8"), "true") = 0 Тогда
		Лог("Агент НЕ принял результат: код=" + Формат(ОтветАгента.КодСостояния, "ЧН=0; ЧГ=0")
			+ ", ответ=" + ОтветАгента.ПолучитьТелоКакСтроку("UTF-8")
			+ ", отправляли=" + Лев(ТелоСтрокой, 200));
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Истина -> задание получено и выполнено (следующее спрашиваем сразу).
Функция ОпроситьОднократно()
	Попытка
		Запрос = Новый HTTPЗапрос("/task?wait=" + Формат(ОжиданиеОпроса, "ЧН=0; ЧГ=0"));
		Запрос.Заголовки.Вставить("X-Agent-Token", Разбор.Токен);
		Ответ = СоединениеСАгентом().Получить(Запрос);
	Исключение
		// Агента сейчас нет — ШТАТНОЕ состояние: он живёт внутри процесса Claude
		// и поднимается только на время работы. НО молчать нельзя: ровно на этом
		// потеряли время — раннер писал "запущен", а до агента не доходил ни один
		// запрос, и причина (сертификат/прокси/файрвол) нигде не была видна.
		// Поэтому логируем первую ошибку и дальше каждую двадцатую (~минута).
		ОшибокПодряд = ОшибокПодряд + 1;
		Если ОшибокПодряд = 1 Или ОшибокПодряд % 20 = 0 Тогда
			Лог("Агент недоступен (попытка " + Формат(ОшибокПодряд, "ЧН=0; ЧГ=0") + "): " + ОписаниеОшибки());
		КонецЕсли;
		Подождать(3);
		Возврат Ложь;
	КонецПопытки;
	ОшибокПодряд = 0;

	Если Ответ.КодСостояния = 204 Тогда
		Возврат Ложь;
	ИначеЕсли Ответ.КодСостояния = 401 Тогда
		Лог("Неверный токен — проверьте адрес после #");
		Подождать(10);
		Возврат Ложь;
	ИначеЕсли Ответ.КодСостояния <> 200 Тогда
		// 502/503/504 — прокси на месте, агента за ним нет; тоже штатно
		Подождать(3);
		Возврат Ложь;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
	Задание = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	НомерЗадания = Задание.Получить("seq");
	Если Задание.Получить("mode") = "exec" Тогда
		Результат = ВыполнитьТекст(Задание.Получить("code"));
	Иначе
		Результат = ВыполнитьОбработку(Base64Значение(Задание.Получить("epf_b64")));
	КонецЕсли;

	Попытка
		Если ОтправитьРезультат(НомерЗадания, Результат) Тогда
			Лог("Задание " + Формат(НомерЗадания, "ЧН=0; ЧГ=0") + " выполнено");
		Иначе
			// Агент результат не принял. Сразу спрашивать следующее задание
			// нельзя: доска отдаст то же самое, и получится бесконечный повтор
			// (ровно это и случилось на BOM в теле ответа).
			Подождать(2);
		КонецЕсли;
	Исключение
		Лог("Результат задания " + Формат(НомерЗадания, "ЧН=0; ЧГ=0") + " отправить не удалось: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Истина;
КонецФункции

// Разовая проверка канала при старте. Без неё "раннер запущен" ничего не
// доказывает: до агента он мог и не дойти.
Процедура ПроверитьСвязь()
	Попытка
		Запрос = Новый HTTPЗапрос("/ping");
		Запрос.Заголовки.Вставить("X-Agent-Token", Разбор.Токен);
		Ответ = СоединениеСАгентом().Получить(Запрос);
		Лог("Проверка связи: код " + Формат(Ответ.КодСостояния, "ЧН=0; ЧГ=0")
			+ ", ответ " + Лев(Ответ.ПолучитьТелоКакСтроку("UTF-8"), 100));
		Если Ответ.КодСостояния = 401 Тогда
			Сообщить("Агент отвечает 401 — неверный токен (часть адреса после #).");
		ИначеЕсли Ответ.КодСостояния = 200 Тогда
			Сообщить("Связь с агентом есть.");
		Иначе
			Сообщить("Агент ответил кодом " + Формат(Ответ.КодСостояния, "ЧН=0; ЧГ=0") + " — см. лог.");
		КонецЕсли;
	Исключение
		Лог("Проверка связи НЕ УДАЛАСЬ: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Сообщить("Связаться с агентом не удалось: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// --- ТИК-РЕЖИМ (вызывается таймером ОБЫЧНОЙ ФОРМЫ) ---
//
// Раньше здесь крутился бесконечный цикл прямо в теле модуля. Он занимал
// главный поток толстого клиента: окно 1С помечалось "не отвечает", сеанс
// нельзя было закрыть иначе как через диспетчер задач (поймано живьём).
// Теперь один шаг опроса = один вызов РаннерТик() из ПодключитьОбработчик-
// Ожидания формы: между тиками сеанс живой и обычный.

Процедура РаннерТик() Экспорт
	Если Не Работает Тогда
		Возврат;
	КонецЕсли;

	Если Не Проверено Тогда
		Проверено = Истина;
		Лог("Раннер запущен: " + Разбор.Схема + "://" + Разбор.Хост + ":" + Формат(Разбор.Порт, "ЧН=0; ЧГ=0")
			+ ", база " + СтрокаСоединенияИнформационнойБазы());
		ПроверитьСвязь();
	КонецЕсли;

	// Стоп-флаг остаётся — он удобен, когда до окна не дотянуться.
	НайденныйФлаг = "";
	ФайлФлага = Новый Файл(ПутьСтопФлага);
	ФайлФлагаПростой = Новый Файл(ПутьСтопФлагаПростой);
	Если ФайлФлага.Существует() Тогда
		НайденныйФлаг = ПутьСтопФлага;
	ИначеЕсли ФайлФлагаПростой.Существует() Тогда
		НайденныйФлаг = ПутьСтопФлагаПростой;
	КонецЕсли;
	Если Не ПустаяСтрока(НайденныйФлаг) Тогда
		Лог("Найден стоп-флаг " + НайденныйФлаг + " — останавливаюсь");
		Попытка
			УдалитьФайлы(НайденныйФлаг);
		Исключение
		КонецПопытки;
		РаннерСтоп();
		Возврат;
	КонецЕсли;

	// Заданий обычно нет — тогда это один короткий запрос и выход до
	// следующего тика. Если задание пришло, разбираем несколько подряд:
	// они идут пачкой, и ждать тик между ними — потерянное время.
	Для Шаг = 1 По 5 Цикл
		Если Не ОпроситьОднократно() Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция РаннерРаботает() Экспорт
	Возврат Работает;
КонецФункции

Процедура РаннерСтарт() Экспорт
	Если ПустаяСтрока(Разбор.Хост) Тогда
		Сообщить("Адрес агента не задан — раннер не запущен.");
		Возврат;
	КонецЕсли;
	Работает = Истина;
	Состояние("Раннер 1С-агента: работает");
КонецПроцедуры

Процедура РаннерСтоп() Экспорт
	Работает = Ложь;
	Лог("Раннер остановлен");
	Состояние("Раннер 1С-агента: остановлен");
	Сообщить("Раннер 1С-агента остановлен.");
КонецПроцедуры

// Переключатель для кнопки формы.
Процедура РаннерПереключить() Экспорт
	Если Работает Тогда
		РаннерСтоп();
	Иначе
		РаннерСтарт();
		Сообщить("Раннер 1С-агента запущен.");
	КонецЕсли;
КонецПроцедуры

// --- адрес агента ---
//
// ПутьОбмена — реквизит ФОРМЫ, поэтому модуль объекта его не видит: форма
// отдаёт значение сюда через УстановитьАдрес(), а при открытии спрашивает
// АдресПоУмолчанию(), чтобы подставить в поле последнее рабочее значение.
// Хранилище дёргаем через Вычислить/Выполнить — по той же причине, что и
// Приостановить(): отсутствие метода должно быть исключением, а не ошибкой
// компиляции всего модуля.

Функция СохранённыйАдрес()
	Попытка
		Значение = Вычислить("ХранилищеОбщихНастроек.Загрузить(""1СAgent"", ""АдресРаннера"")");
		Если Значение = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат СокрЛП(Строка(Значение));
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Процедура СохранитьАдрес(Знач Адрес)
	Попытка
		Выполнить("ХранилищеОбщихНастроек.Сохранить(""1СAgent"", ""АдресРаннера"", """ + Адрес + """)");
	Исключение
		Лог("Адрес сохранить не удалось: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Что подставить в поле формы при открытии: ключ /C важнее сохранённого.
Функция АдресПоУмолчанию() Экспорт
	Адрес = СокрЛП(ПараметрЗапуска);
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = СохранённыйАдрес();
	КонецЕсли;
	Возврат Адрес;
КонецФункции

// Истина -> адрес принят, можно стартовать.
Функция УстановитьАдрес(Знач Адрес) Экспорт
	Адрес = СокрЛП(Адрес);
	Если ПустаяСтрока(Адрес) Тогда
		Сообщить("Укажите адрес агента вида https://хост#токен");
		Возврат Ложь;
	КонецЕсли;
	Разобранный = РазобратьАдресАгента(Адрес);
	Если ПустаяСтрока(Разобранный.Хост) Или ПустаяСтрока(Разобранный.Токен) Тогда
		Сообщить("Адрес должен быть вида https://хост#токен, получено: " + Адрес);
		Возврат Ложь;
	КонецЕсли;
	Разбор = Разобранный;
	Проверено = Ложь;   // связь проверим на первом тике нового адреса
	СохранитьАдрес(Адрес);
	Возврат Истина;
КонецФункции

